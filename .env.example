# Set environment variables in your shell; the app does not auto-load this file.
JON_DATA_DIR=./data
# Local or HTTPS OpenAI-compatible inference endpoint. Empty = evidence-only mode.
JON_MODEL_URL=http://127.0.0.1:8000/v1
JON_MODEL=Qwen/Qwen3.5-35B-A3B
JON_MODEL_KEY=
# Optional public GitHub API token, never sent to the browser.
JON_GITHUB_TOKEN=
# Employer-authorized Greenhouse Job Board credentials only, mapped by board slug.
# JON_GREENHOUSE_KEYS={"your-board":"your-api-key"}
